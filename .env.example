# JWT Maxfiy kaliti (kamida 32 ta belgidan iborat ixtiyoriy matn)
JWT_SECRET=bogishamol-super-secret-production-jwt-key-2026!

# Dastlabki admin foydalanuvchisi (birinchi marta ishga tushganda avtomatik yaratiladi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULLNAME=Bog'ishamol Admin
